{
  "description": "Relay Claude installed-plugin PreToolUse observation fixture.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/node \"${CLAUDE_PLUGIN_ROOT}/hooks/record-pretool.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
